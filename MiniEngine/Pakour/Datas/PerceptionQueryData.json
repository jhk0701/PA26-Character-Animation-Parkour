        "class" : "CharacterStateDecorator",
        "comparer" : "Equal",
        "targetState" : "Landing"
    },
    {
        "id" : "IsInAirState",
        "class" : "CharacterStateDecorator",
        "comparer" : "Equal",
        "targetState" : "InAir"
    },
    {
        "id" : "IsHangingState",
        "class" : "CharacterStateDecorator",
        "comparer" : "Equal",
