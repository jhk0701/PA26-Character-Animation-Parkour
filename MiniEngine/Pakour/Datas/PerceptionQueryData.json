                "distance" : 1.0,
                "radius" : 1.0,
                "height" : 1.0,
                "heightMultiplier" : 1.5
            },
        {
            "id" : "BeamStandState",
            "class" : "SequenceNode",
            "decos" : [ "IsBeamStandState" ],
            "children" : [ "Beam_DetectFoward", "Obstacle_Detected" ]
        },
        {
            "id" : "BeamHangingState",
            "class" : "SequenceNode",
            "decos" : [ "IsBeamHangingState" ],
            "children" : [ "Beam_DetectFoward", "Obstacle_Detected" ]
        },
            {
                "id" : "Beam_DetectFoward",
                "class" : "DetectObstacleSphereNode",
                "startOffset" : [ 0.0, 0.75, 0.0 ],
                "direction" : [ 0.0, 0.0, 1.0 ],
                "distance" : 2.5,
                "radius" : 1.5
            },
        {
            "id" : "HangingState",
            "class" : "SequenceNode",
            "decos" : [ "IsHangingState" ],
            "children" : []
        },
        {
            "id" : "PoleState",
            "class" : "SequenceNode",
            "decos" : [ "IsPoleState" ],
            "children" : [ "Hanging_Detect_TowardInput", "Hanging_Process_Detect" ]
        },
            {
                "id" : "Hanging_Detect_TowardInput",
                "class" : "DetectObstacleUsingInputNode",
                "startOffset" : [ 0.0, 0.75, 0.0 ],
                "distance" : 2.0,
                "radius" : 1.0
            },
            {
                "id" : "Hanging_Process_Detect",
                "class" : "SelectorNode",
                "children" : [ "Hanging_Detected", "Hanging_NotDetected" ]
            },
                {
                    "id" : "Hanging_Detected",
                    "comment" : "장애물 태그로 나누되, Default의 경우 입력 방향에 따른 처리 필요",
                    "class" : "SelectorNode",
                    "decos" : [ "ObstacleDetected" ],
                    "children" : [
                        "Hanging_Detected_Default", 
                        "Process_Beam", 
                        "Process_Protrude", 
                        "Process_Pole"
                    ]
                },
                    {
                        "id" : "Hanging_Detected_Default",
                        "comment" : "Default의 경우, 입력 y 값에 따라 처리 세분화. 아래 쪽에 장애물은 착지 시도"
                    },
                {
                    "id" : "Hanging_NotDetected",
                    "comment" : "입력 받고 있는 방향으로 이동 가능한지 확인",
                    "class" : "SelectorNode",
                    "children" : []
                }

  ]
}