    {
        "id" : "IsInputDown",
        "class" : "InputVerticalDecorator",
        "comparer" : "Lesser",
        "val_float" : "-0.1"
    },
    {
        "id" : "IsInputRight",
        "class" : "InputHorizontalDecorator",
        "comparer" : "Greater",
        "val_float" : "0.1"
    },
    {
        "id" : "IsInputLeft",
        "class" : "InputHorizontalDecorator",
        "comparer" : "Lesser",
        "val_float" : "-0.1"
