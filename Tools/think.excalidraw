      "versionNonce": 1218437011,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785463286278,
      "link": null,
      "locked": false,
      "text": "공통 사항\n- 얇거나 좁은 발판, 봉 따위 처리\n- Landing, Hanging, InAir에서도 처리 가능\n- 특이사항",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "공통 사항\n- 얇거나 좁은 발판, 봉 따위 처리\n- Landing, Hanging, InAir에서도 처리 가능\n- 특이사항",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ulwSG1MNXuWj9h93ye236",
      "type": "text",
      "x": 1806.5044266111072,
      "y": 3465.8215135723076,
      "width": 229.50375366210938,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
