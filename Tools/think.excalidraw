      "originalText": "Owner의 현재 추가 정보\n- 현재 상태 (uint8_t)\n- 입력 방향 (vector2)\n- ....",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "15lULsQctPUFkW7ghccZH",
      "type": "text",
      "x": -1618.742053747671,
      "y": 5465.414413899821,
      "width": 248.82298278808594,
