      "versionNonce": 271575539,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785809726335,
      "link": null,
      "locked": false,
      "text": "콘텐츠에서 추가해서 등록하는 데이터\n매번 추가해서 쓸 순 없고",
      "fontSize": 16.05117801842576,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "콘텐츠에서 추가해서 등록하는 데이터\n매번 추가해서 쓸 순 없고",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YWgf2Q5p8naCPpiZXeN9y",
      "type": "text",
