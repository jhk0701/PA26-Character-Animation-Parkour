    {
      "id": "SjEUXMHISnY9M_ixEFsM9",
      "type": "text",
      "x": -1124.6859908041754,
      "y": 5133.699399240898,
      "width": 179.18206787109375,
      "height": 20.0639725230322,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#b2f2bb",
