      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "자식 조건이 모두 True여야 True 처리\n도중에 False인 경우 중단",
      "autoResize": true,
      "lineHeight": 1.25
    },
